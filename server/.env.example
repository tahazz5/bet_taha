NODE_ENV=production
PORT=4000
# Generate two different random values: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-second-random-secret-at-least-32-characters
APP_ORIGIN=https://your-domain.example
TRUST_PROXY_HOPS=1
DB_PATH=/app/data/betting.db
FOOTBALL_API_KEY=your-api-football-key
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
# Keep disabled in production. This route only exists for local demos.
ENABLE_DEMO_TOOLS=false
